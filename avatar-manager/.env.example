AVATAR_BACKEND_URL=http://127.0.0.1:3001/api/v1
# For production, use the NestJS API's HTTPS URL ending in /api/v1.
# Match the production backend token. Do not use NEXT_PUBLIC_ for this secret.
AVATAR_MANAGER_TOKEN=

# Service frontend origin. Publishing verifies one static deployment manifest here.
AVATAR_FRONTEND_URL=http://127.0.0.1:3000
# Optional: absolute service frontend folder (default: ../frontend). Supports Windows paths.
# AVATAR_FRONTEND_DIR=C:\work\project-health\frontend
