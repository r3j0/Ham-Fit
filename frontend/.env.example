# 브라우저에서 직접 접근할 API 주소. /api/v1까지 포함합니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# 백엔드 FRONTEND_ORIGIN은 브라우저 주소와 일치해야 합니다.
# 로컬 기본값: http://localhost:3000

# 완료 보상 영수증 API는 구현/배포 후에만 true로 설정합니다.
NEXT_PUBLIC_DAILY_REWARDS_ENABLED=false
# 개인 룰렛은 backend/docs/streak-roulette.md의 최신 서버 계약을 사용합니다.
NEXT_PUBLIC_PERSONAL_ROULETTE_ENABLED=true
