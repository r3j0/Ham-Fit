NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Generate a real value with npm run auth:secret; never use a shared default.
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SAME_SITE=lax
# Comma-separated addresses/CIDRs of actual reverse proxies; empty trusts none.
TRUST_PROXY_CIDRS=
DATABASE_URL=postgresql://project_health:CHANGE_ME@127.0.0.1:15432/project_health?schema=public
TEST_DATABASE_URL=postgresql://project_health:CHANGE_ME@127.0.0.1:15432/project_health_test?schema=public

# Optional server-only OpenAI image extraction. Empty settings disable only extraction.
# Use a project API key via the backend secret manager; never log or commit its value.
OPENAI_API_KEY=
# Set an account-accessible model supporting image input, Responses and Structured Outputs.
# No automatic model selection or fallback. See docs/measurement-extraction-api.md.
OPENAI_OCR_MODEL=

# Optional externally generated MP4 verification data; missing data disables playback URLs.
# Default: .local/recommendation/media-verification.json (not tracked by Git).
WORKOUT_MEDIA_REPORT_PATH=

# Actual multi-exercise routine runtime. Install requirements-recommendation.txt first.
# Defaults to python3 on PATH. For a local venv use its absolute bin/python path.
RECOMMENDATION_PYTHON=
# Defaults to read-only files under ../data-analysis; see docs/recommendations/routines-api.md.
RECOMMENDATION_SOURCE_PATH=
WORKOUT_VIDEOS_PATH=

# Optional avatar manager publishing (server-only, leave unset to disable).
# AVATAR_MANAGER_TOKEN=<64 lowercase hex characters>
# Clothing PNGs live in frontend/public/hamsters/wardrobe/assets.
# The API stores metadata only; Blob / Supabase Storage credentials are unnecessary.
