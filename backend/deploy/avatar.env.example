# Add these to the NestJS API project's Production environment, not the frontend.
AVATAR_ASSET_STORAGE=supabase
# Generate 32 random bytes as 64 lowercase hex characters. Match the local editor.
AVATAR_MANAGER_TOKEN=
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only secret key (sb_secret_...) or legacy service_role key; never a publishable key.
SUPABASE_SECRET_KEY=
# Create a PRIVATE bucket with image/png allowed and an 8 MiB file size limit.
SUPABASE_AVATAR_BUCKET=avatar-assets
# Existing Blob deployments can explicitly keep AVATAR_ASSET_STORAGE=vercel-blob
# with BLOB_READ_WRITE_TOKEN or Vercel-managed BLOB_STORE_ID + VERCEL_OIDC_TOKEN.
