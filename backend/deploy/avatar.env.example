# Add these to the NestJS API project's Production environment, not the frontend.
AVATAR_ASSET_STORAGE=vercel-blob
# Generate 32 random bytes as 64 lowercase hex characters. Match the local editor.
AVATAR_MANAGER_TOKEN=
# Connect a PRIVATE Vercel Blob store. Keep this credential server-only.
# The SDK also supports Vercel-managed BLOB_STORE_ID + VERCEL_OIDC_TOKEN.
BLOB_READ_WRITE_TOKEN=
